{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agenthd-tauri-angular-spike",
  "version": "0.1.0",
  "identifier": "dev.agenthd.spike.tauri-angular",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://127.0.0.1:14720",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/agenthd-tauri-angular-spike/browser"
  },
  "app": {
    "windows": [
      {
        "title": "agenthd spike (D1 / Tauri + Angular)",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://127.0.0.1:14720 http://127.0.0.1:14720",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
